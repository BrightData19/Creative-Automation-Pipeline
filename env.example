# Environment Configuration for Creative Automation Pipeline
# Copy this file to .env and adjust values as needed

# =============================================================================
# KAFKA CONFIGURATION
# =============================================================================
KAFKA_BROKER=localhost:9092
KAFKA_INTERNAL_BROKER=kafka:29092

# =============================================================================
# APPLICATION PORTS & URLs
# =============================================================================
FRONTEND_PORT=3000
REALTIME_GATEWAY_PORT=3001
NEXT_PUBLIC_GATEWAY_URL=http://localhost:3001

# =============================================================================
# DROPBOX CONFIGURATION
# =============================================================================
DROPBOX_ROOT=/Apps/CreativeAutomation
DROPBOX_ACCESS_TOKEN=your_dropbox_access_token_here
DROPBOX_REFRESH_TOKEN=your_dropbox_refresh_token_here
DROPBOX_APP_KEY=your_dropbox_app_key_here
DROPBOX_APP_SECRET=your_dropbox_app_secret_here

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================
NODE_ENV=development
LOG_LEVEL=info
ENABLE_KAFKA=true

# =============================================================================
# STORAGE BACKEND (dropbox | local)
# =============================================================================
STORAGE_BACKEND=dropbox
LOCAL_ROOT=local_storage

# =============================================================================
# PRIVACY & GOVERNANCE
# =============================================================================
REDACT_PII=true
RETENTION_DAYS=0

# =============================================================================
# GENAI PROVIDER API KEYS
# =============================================================================
# Google Gemini 2.5 Flash Image (Priority 1)
GOOGLE_GEMINI_API_KEY=your_gemini_api_key_here

# Adobe Firefly (Priority 2)
ADOBE_FIREFLY_CLIENT_ID=your_adobe_client_id_here
ADOBE_FIREFLY_CLIENT_SECRET=your_adobe_client_secret_here

# OpenAI DALL-E 3 (Priority 3 - Fallback)
OPENAI_API_KEY=your_openai_api_key_here

# =============================================================================
# COMPLIANCE & BRAND GUIDELINES
# =============================================================================
BRAND_COMPLIANCE_ENABLED=true
LEGAL_CONTENT_FILTERING_ENABLED=true
LOGO_DETECTION_ENABLED=true
CONTENT_SAFETY_ENABLED=true
BRAND_GUIDELINES_STRICT_MODE=true
AUDIT_LOGGING_ENABLED=true

# =============================================================================
# LOCALIZATION SETTINGS
# =============================================================================
DEFAULT_TARGET_MARKET=US
SUPPORTED_LANGUAGES=en,de,fr,ja,pt
CULTURAL_ADAPTATION_ENABLED=true

# =============================================================================
# PERFORMANCE & QUALITY THRESHOLDS
# =============================================================================
MIN_COMPLIANCE_SCORE=0.8
MIN_LOCALIZATION_SCORE=0.7
MIN_QUALITY_SCORE=0.6
MAX_RETRY_ATTEMPTS=3

# =============================================================================
# MONITORING & ALERTING
# =============================================================================
ALERT_EMAIL_ENABLED=false
ALERT_WEBHOOK_URL=
SLACK_WEBHOOK_URL=

# =============================================================================
# IMAGE PROCESSING & GENERATION
# =============================================================================
# Default image dimensions for generation
DEFAULT_IMAGE_WIDTH=1024
DEFAULT_IMAGE_HEIGHT=1024

# Aspect ratio configurations
ASPECT_RATIO_1_1=1080x1080
ASPECT_RATIO_16_9=1920x1080
ASPECT_RATIO_9_16=1080x1920

# Image quality settings
IMAGE_QUALITY=95
IMAGE_FORMAT=jpg

# =============================================================================
# COMPLIANCE ENGINE SETTINGS
# =============================================================================
# Logo detection settings
LOGO_DETECTION_THRESHOLD=0.7
MIN_LOGO_SIZE_RATIO=0.05
MAX_TEXT_RATIO=0.3

# Brand color settings
BRAND_COLOR_SIMILARITY_THRESHOLD=0.8
BRAND_COLOR_WEIGHT=0.4

# Content filtering settings
PROHIBITED_WORD_WEIGHT=0.2
MAX_TEXT_LENGTH=1000

# =============================================================================
# AGENT WORKER SETTINGS
# =============================================================================
# Diversity evaluation
DIVERSITY_THRESHOLD=5
MIN_VARIANTS_PER_PRODUCT=3

# Performance metrics
QUALITY_SCORE_WEIGHT=0.3
COMPLIANCE_SCORE_WEIGHT=0.4
LOCALIZATION_SCORE_WEIGHT=0.3

# =============================================================================
# PIPELINE WORKER SETTINGS
# =============================================================================
# Processing settings
MAX_CONCURRENT_CAMPAIGNS=10
CAMPAIGN_TIMEOUT_SECONDS=300
ASSET_GENERATION_TIMEOUT_SECONDS=120

# Retry settings
MAX_GENERATION_RETRIES=3
RETRY_DELAY_SECONDS=5
BACKOFF_MULTIPLIER=2

# =============================================================================
# FRONTEND SETTINGS
# =============================================================================
# Dashboard settings
DASHBOARD_REFRESH_INTERVAL_MS=5000
MAX_EVENTS_DISPLAYED=200
EVENT_HISTORY_RETENTION_HOURS=24

# =============================================================================
# REALTIME GATEWAY SETTINGS
# =============================================================================
# WebSocket settings
WEBSOCKET_HEARTBEAT_INTERVAL_MS=30000
WEBSOCKET_MAX_CONNECTIONS=1000
SSE_RETRY_TIMEOUT_MS=5000

# =============================================================================
# SECURITY & AUTHENTICATION
# =============================================================================
# API security
API_RATE_LIMIT_REQUESTS_PER_MINUTE=100
API_RATE_LIMIT_BURST=20
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRY_HOURS=24

# CORS settings
CORS_ORIGIN=http://localhost:3000
CORS_CREDENTIALS=true

# =============================================================================
# LOGGING & MONITORING
# =============================================================================
# Log levels
LOG_LEVEL_ROOT=info
LOG_LEVEL_KAFKA=warn
LOG_LEVEL_DROPBOX=info
LOG_LEVEL_GENAI=info

# Log output
LOG_FORMAT=json
LOG_FILE_PATH=logs/
LOG_MAX_SIZE_MB=100
LOG_MAX_FILES=10

# =============================================================================
# TESTING & DEVELOPMENT
# =============================================================================
# Test settings
TEST_MODE=false
MOCK_GENAI_RESPONSES=false
SKIP_COMPLIANCE_CHECKS=false
FAST_MODE=false

# Development helpers
DEBUG_MODE=true
VERBOSE_LOGGING=false
SHOW_PERFORMANCE_METRICS=true

# =============================================================================
# PRODUCTION OVERRIDES
# =============================================================================
# Uncomment and set these for production deployment
# NODE_ENV=production
# LOG_LEVEL=warn
# DEBUG_MODE=false
# VERBOSE_LOGGING=false
# SHOW_PERFORMANCE_METRICS=false
