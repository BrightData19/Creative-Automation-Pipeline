{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AlertEventV1",
  "description": "Schema for an alert generated by the agent worker.",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "ts": {
      "type": "string",
      "format": "date-time"
    },
    "severity": {
      "type": "string",
      "enum": ["info", "warning", "error"]
    },
    "campaign_name": {
      "type": "string"
    },
    "issue": {
      "type": "string",
      "enum": [
        "insufficient_variants",
        "insufficient_diversity",
        "pipeline_error",
        "compliance_violation"
      ]
    },
    "detail": {
      "type": "string",
      "description": "A technical description of the issue."
    },
    "audience": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["marketing", "it", "legal", "creative"]
      },
      "description": "The target audience for this alert."
    },
    "human_message": {
      "type": "string",
      "description": "A clear, human-readable message drafted by the LLM or a template."
    }
  },
  "required": [
    "event_id",
    "ts",
    "severity",
    "campaign_name",
    "issue",
    "detail",
    "audience",
    "human_message"
  ]
}
