# Environment variables for Creative Automation Pipeline
# Copy this file to ".env" and fill in values.

# =============================================================================
# KAFKA CONFIGURATION
# =============================================================================
KAFKA_BROKER=localhost:9092
# Internal Docker broker (used by services running in compose)
KAFKA_INTERNAL_BROKER=kafka:29092

# =============================================================================
# APPLICATION PORTS & URLs
# =============================================================================
# Local ports for services
FRONTEND_PORT=3000
REALTIME_GATEWAY_PORT=3001

# Public URL for the realtime gateway used by the frontend
NEXT_PUBLIC_GATEWAY_URL=http://localhost:3001

# =============================================================================
# STORAGE CONFIGURATION
# =============================================================================
# Select where uploaded assets are stored: "dropbox" or "local"
STORAGE_BACKEND=dropbox

# Local storage root (used when STORAGE_BACKEND=local)
LOCAL_ROOT=local_storage

# =============================================================================
# DROPBOX CONFIGURATION
# =============================================================================
# Recommended: OAuth2 refresh token flow (short‑lived access tokens managed by SDK)
DROPBOX_APP_KEY=your_dropbox_app_key
DROPBOX_APP_SECRET=your_dropbox_app_secret
DROPBOX_REFRESH_TOKEN=your_dropbox_refresh_token

# Optional: fallback to a static long‑lived access token (not recommended)
DROPBOX_ACCESS_TOKEN=your_dropbox_access_token

# Root folder within Dropbox where files are created
DROPBOX_ROOT=/Apps/CreativeAutomation

# =============================================================================
# OPENAI / GENAI CONFIGURATION (optional)
# =============================================================================
# OPENAI_API_KEY=your_openai_api_key
# GOOGLE_GEMINI_API_KEY=your_google_gemini_api_key

# =============================================================================
# FRONTEND SETTINGS (optional)
# =============================================================================
DASHBOARD_REFRESH_INTERVAL_MS=5000
MAX_EVENTS_DISPLAYED=200
EVENT_HISTORY_RETENTION_HOURS=24

# =============================================================================
# REALTIME GATEWAY SETTINGS (optional)
# =============================================================================
WEBSOCKET_HEARTBEAT_INTERVAL_MS=30000
WEBSOCKET_MAX_CONNECTIONS=1000
SSE_RETRY_TIMEOUT_MS=5000

# =============================================================================
# SECURITY & CORS (optional)
# =============================================================================
CORS_ORIGIN=http://localhost:3000
CORS_CREDENTIALS=true
JWT_SECRET=change_me_in_production
JWT_EXPIRY_HOURS=24

# =============================================================================
# LOGGING (optional)
# =============================================================================
NODE_ENV=development
LOG_LEVEL=info
LOG_LEVEL_ROOT=info
LOG_LEVEL_KAFKA=warn
LOG_LEVEL_DROPBOX=info
LOG_LEVEL_GENAI=info
LOG_FORMAT=json
LOG_FILE_PATH=logs/
LOG_MAX_SIZE_MB=100
LOG_MAX_FILES=10

# =============================================================================
# MISC OPTIONAL SETTINGS (safe defaults)
# =============================================================================
DEFAULT_IMAGE_WIDTH=1024
DEFAULT_IMAGE_HEIGHT=1024
ASPECT_RATIO_1_1=1080x1080
ASPECT_RATIO_16_9=1920x1080
ASPECT_RATIO_9_16=1080x1920
IMAGE_QUALITY=95
IMAGE_FORMAT=jpg

# Feature toggles
BRAND_COMPLIANCE_ENABLED=true
LEGAL_CONTENT_FILTERING_ENABLED=true
LOGO_DETECTION_ENABLED=true
CONTENT_SAFETY_ENABLED=true
BRAND_GUIDELINES_STRICT_MODE=true
AUDIT_LOGGING_ENABLED=true

# Localization
DEFAULT_TARGET_MARKET=US
SUPPORTED_LANGUAGES=en,de,fr,ja,pt
CULTURAL_ADAPTATION_ENABLED=true

# Pipelines
MAX_CONCURRENT_CAMPAIGNS=10
CAMPAIGN_TIMEOUT_SECONDS=300
ASSET_GENERATION_TIMEOUT_SECONDS=120
MAX_GENERATION_RETRIES=3
RETRY_DELAY_SECONDS=5
BACKOFF_MULTIPLIER=2
